{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    ".vitepress/**/*",
    "posts/**/*.md",
    "investment/**/*.md",
    "*.ts",
    "*.vue"
  ],
  "vueCompilerOptions": {
    "plugins": []
  },
  "exclude": [
    "node_modules",
    "**/node_modules",
    ".agents",
    ".agents/**/*",
    ".claude",
    ".claude/**/*",
    ".vitepress/dist",
    ".vitepress/cache",
    "**/*.timestamp-*"
  ]
}