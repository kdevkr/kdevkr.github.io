{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": [
    ".vitepress/**/*",
    "posts/**/*.md",
    "archive/**/*.md",
    "investment/**/*.md",
    "*.ts",
    "*.vue"
  ],
  "vueCompilerOptions": {
    "plugins": []
  },
  "exclude": [
    "node_modules",
    "**/node_modules",
    ".agents",
    ".agents/**/*",
    ".claude",
    ".claude/**/*",
    ".vitepress/dist",
    ".vitepress/cache"
  ]
}