{
  "compilerOptions": {
    "module": "NodeNext",
    "allowJs": true,
    "strict": true,
    "jsx": "preserve"
  },
  "include": [
    "./.vitepress/**/*",
    "**/*.ts",
    "**/*.vue",
    "**/*.md",
  ],
  "vueCompilerOptions": {
    "vitePressExtensions": [".md"],
  },
  "exclude": [
    "node_modules"
  ]
}